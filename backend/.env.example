# LLM Provider 配置
# provider 可选: openai, deepseek
LLM_PROVIDER=deepseek

# API Key（根据 provider 选择对应的 key）
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# 可选：自定义 base_url 和 model
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# 可选：LLM 参数
# LLM_TEMPERATURE=0.7
# LLM_MAX_TOKENS=2000
# LLM_MAX_RETRIES=3

# 工作目录（Agent 执行命令和读写文件的根目录）
# WORKSPACE=.

# 数据存储目录
# DATA_DIR=data/sessions

# 日志目录
# LOG_DIR=logs

# Agent 配置
# MAX_ITERATIONS=20
# MAX_CONTEXT_TOKENS=8000

# 服务器配置
# HOST=127.0.0.1
# PORT=8000
# DEBUG=false

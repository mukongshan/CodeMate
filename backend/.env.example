# LLM provider: openai, deepseek, or any OpenAI-compatible gateway.
LLM_PROVIDER=deepseek
LLM_API_KEY=your_api_key_here

# Optional LLM settings.
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000
LLM_MAX_RETRIES=3

# Web search provider.
WEB_SEARCH_PROVIDER=bocha
BOCHA_API_KEY=your_bocha_api_key_here
BOCHA_BASE_URL=https://api.bochaai.com
BOCHA_SEARCH_FRESHNESS=noLimit
BOCHA_SEARCH_SUMMARY=true

# Optional Volcengine/Doubao Search Global provider.
# Set WEB_SEARCH_PROVIDER=volcengine to enable it.
VOLCENGINE_SEARCH_API_KEY=your_volcengine_search_api_key_here
VOLCENGINE_SEARCH_ENDPOINT=https://open.feedcoopapi.com/search_api/global_search
VOLCENGINE_SEARCH_MAX_SNIPPET_LENGTH=1000
VOLCENGINE_SEARCH_ICP_HOST_ONLY=false

# Agent runtime.
WORKSPACE=.
DATA_DIR=data/sessions
LOG_DIR=logs
MAX_ITERATIONS=20
MAX_CONTEXT_TOKENS=8000
CONTEXT_RESERVE_TOKENS=2000
COMPACTION_KEEP_RECENT_TOKENS=3000
COMPACTION_SUMMARY_MAX_TOKENS=1200
COMPACTION_THRESHOLD_RATIO=0.8

# Server.
HOST=127.0.0.1
PORT=8000
DEBUG=false

# CORS allowlist, split multiple origins with commas.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

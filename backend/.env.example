# LLM provider: openai, deepseek, or any OpenAI-compatible gateway.
LLM_PROVIDER=deepseek
LLM_API_KEY=your_api_key_here

# Optional LLM settings.
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000
LLM_MAX_RETRIES=3

# Agent runtime.
WORKSPACE=.
DATA_DIR=data/sessions
LOG_DIR=logs
MAX_ITERATIONS=20
MAX_CONTEXT_TOKENS=8000

# Server.
HOST=127.0.0.1
PORT=8000
DEBUG=false

# CORS allowlist, split multiple origins with commas.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
